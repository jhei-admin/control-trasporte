DEBUG=false
SECRET_KEY=reemplazar_por_una_clave_larga_y_segura
DATABASE_URL=postgresql://usuario:password@host:5432/base
RENDER=true
FAIL_ON_SQLITE_IN_PRODUCTION=true
SECURE_SSL_REDIRECT=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
ALLOWED_HOSTS=control-trasporte.onrender.com
CSRF_TRUSTED_ORIGINS=https://control-trasporte.onrender.com
CORS_ALLOWED_ORIGINS=https://control-trasporte.onrender.com
DATABASE_CONNECT_TIMEOUT=10
GPS_RETENTION_DAYS=15
PARADAS_RETENTION_DAYS=2
INACTIVE_SESSION_RETENTION_DAYS=7
MENSAJES_RETENTION_DAYS=30
CLEANUP_BATCH_SIZE=5000
GPS_SAVE_INTERVAL_SECONDS=5
GPS_MAX_PRECISION=100
ALLOW_LEGACY_QR=false
MAPBOX_TOKEN=reemplazar_si_el_mapa_lo_requiere
APP_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=ERROR
DJANGO_REQUEST_LOG_LEVEL=ERROR
RUN_STARTUP_AUDIT=false
